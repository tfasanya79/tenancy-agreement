# ---------------------------------------------------------------------------
# TenancyDesk configuration
# Copy this file to `.env` and fill in the two values marked REQUIRED.
#   cp .env.example .env      (macOS / Linux)
#   copy .env.example .env    (Windows)
# ---------------------------------------------------------------------------

# REQUIRED — your DeepSeek API key.
# Get one at https://platform.deepseek.com  →  API Keys
DEEPSEEK_API_KEY=sk-your-key-here

# The model the agent uses. `deepseek-chat` is the right choice here:
# it is fast, cheap, and supports function calling (tools).
# Do not use `deepseek-reasoner` — it does not support tools.
DEEPSEEK_MODEL=deepseek-chat

# Only change this if DeepSeek gives you a different endpoint (e.g. a proxy).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# Optional settings — the defaults are fine for almost everyone.
# ---------------------------------------------------------------------------

# Web server
PORT=3000
HOST=0.0.0.0

# Where the SQLite database and generated documents are written.
# Keep this on a backed-up disk. Contains tenant personal data.
DATA_DIR=./data

# Your agency's details — pre-filled into every new pack so you type less.
AGENCY_NAME=
AGENCY_EMAIL=
AGENCY_PHONE=
AGENCY_ADDRESS=
# Your client money protection scheme and redress scheme (required by law
# to be displayed). e.g. "Propertymark Client Money Protection" / "The Property Ombudsman"
AGENCY_CLIENT_MONEY_SCHEME=
AGENCY_REDRESS_SCHEME=

# Set to `true` to run the app without calling DeepSeek (renders documents,
# manual data entry only). Useful for a first look or offline testing.
OFFLINE_MODE=false
